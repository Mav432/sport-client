# Environment Variables Template
# Copia este archivo a .env y configura tus valores

# Backend API URL
API_URL=https://back-sport.vercel.app

# Claves de almacenamiento (no cambiar a menos que sea necesario)
STORAGE_TOKEN_KEY=auth_token
STORAGE_USER_KEY=current_user

# Configuración de la aplicación
APP_NAME=Sport Center
APP_VERSION=1.0.0

# Entorno (development | production)
NODE_ENV=development
